    {
      "cell_type": "code",
      "source": [
        "# Heatmap example wit scaled colors\n",
        "# To correspond to MATLAB, requires a bit of data preparation\n",
        "x = np.linspace(-3, 3, 100) # 100 evenly spaced values from the interval [-3,3]\n",
        "y = np.linspace(-2, 2, 50) # 50 evenly spaced values from the interval [-2,2]\n",
        "X, Y = np.meshgrid(x, y) # values organized in a form of a 2d grid for every x-y combination\n",
        "Z = np.exp(-(X**2 + Y**2))  # getting a value for each element of the grid\n",
        "\n",
        "im = plt.imshow(Z, aspect=\"auto\", origin=\"lower\")\n",
        "plt.colorbar(im)\n",
        "plt.title(\"Heatmap example with scaled colors\")\n",
        "plt.show()"
