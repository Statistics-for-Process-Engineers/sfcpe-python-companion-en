        "# Example of a 3D line plot\n",
        "t = np.linspace(0, 10*np.pi, 100)\n",
        "x = np.cos(t)\n",
        "y = np.sin(t)\n",
        "z = t\n",
        "\n",
        "fig = plt.figure()\n",
        "ax = fig.add_subplot(111, projection=\"3d\")\n",
        "ax.plot3D(x, y, z)\n",
        "ax.set_title(\"3D line plot\")\n",
        "plt.show()\n"
