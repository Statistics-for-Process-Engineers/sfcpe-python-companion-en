    {
      "cell_type": "code",
      "source": [
        "# Example of a 3D surface plot\n",
        "x = np.linspace(-3, 3, 100)\n",
        "y = np.linspace(-3, 3, 100)\n",
        "X, Y = np.meshgrid(x, y)\n",
        "Z = np.sin(X) * np.cos(Y)\n",
        "\n",
