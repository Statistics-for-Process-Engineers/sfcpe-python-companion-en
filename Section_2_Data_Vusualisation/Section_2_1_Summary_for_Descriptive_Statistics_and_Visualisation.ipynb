        "# 0) Creating a reproducible synthetic sample\n",
        "rng = np.random.default_rng(2340)\n",
        "\n",
        "# Example B: non-normal data showing more noticeable deviations\n",
        "x = rng.lognormal(mean=0.2, sigma=0.6, size=(100, 1))\n",
        "\n",
        "# 1) Ensuring the shape of a sample to be a 1D NumPy array\n",
        "x = np.asarray(x, dtype=float).ravel()\n",
        "\n",
        "# 2) (Optional) Removing NaNs\n",
        "x = x[~np.isnan(x)]\n",
        "\n",
        "# 3) Computing a plot data for a Normal distribution\n",
        "(osm, osr), (slope, intercept, r) = stats.probplot(x, dist=\"norm\")\n",
        "\n",
        "\n",
        "plt.figure()\n",
        "plt.plot(osm, osr, \"o\", markerfacecolor=\"none\")\n",
        "x_line = np.array([osm.min(), osm.max()])\n",
        "y_line = slope * x_line + intercept\n",
        "plt.plot(x_line, y_line, \"-k\")\n",
        "\n",
        "plt.title(\"Normal Probability Plot (Q–Q plot)\")\n",
        "plt.xlabel(\"Theoretical Quantiles (Normal)\")\n",
        "plt.ylabel(\"Ordered Sample Values\")\n",
        "plt.grid(True)\n",
        "\n",
        "plt.show()"
