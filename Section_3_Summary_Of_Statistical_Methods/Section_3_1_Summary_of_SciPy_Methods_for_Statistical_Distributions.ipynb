    {
      "cell_type": "markdown",
      "source": [
        "## Section 3.1.2. Hypothesis Testing\n",
        "\n",
        "\n",
        "Let\n",
        "\n",
        "- $\\theta$ be the parameter of interest,\n",
        "- $t_{\\text{computed}}$ be the value of the test statistic computed from the sample,\n",
        "- $t_{\\text{crit}}$ be the critical value of the test statistic,\n",
        "- $\\alpha$ be the $\\alpha$ - error.\n"
      ],
      "metadata": {
        "id": "El3RR-91oFHO"
      }
    },
    {
      "cell_type": "code",
      "source": [
        # For this part, the parameters are chosen arbitrarily
        # General statistical parameters
        alpha = 0.05
        # Example test statistic
        t_computed = 1.915

        # Example reference distribution:
        # Student's t-distribution with 6 degrees of freedom
        df = 67
        
        "# Case 1a: two-sided, symmetric distribution\n",
        "dist = stats.t(df=df)\n",
        "t_crit_case1_sym = dist.ppf(1 - alpha / 2.0)\n",
        "\n",
        "# Case 1b: two-sided, asymmetric distribution\n",
        "dist = stats.chi2(df=df)\n",
        "t_crit_lower_case1 = dist.ppf(alpha / 2.0)\n",
        "t_crit_upper_case1 = dist.ppf(1 - alpha / 2.0)"
      ],
      "metadata": {
        "id": "xBjbg3IZqGye"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Case 2: left-sided test\n",
        "t_crit_case2 = dist.ppf(alpha)"
      ],
      "metadata": {
        "id": "LNZZRizJami1"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Case 3: right-sided test\n",
        "t_crit_case3 = dist.ppf(1 - alpha)"
      ],
      "metadata": {
        "id": "tiyv2LD3au0d"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Case 1: two-sided test, symmetric distribution (e.g. *t*-test)\n",
        "dist = stats.t(df=df)\n",
        "tail_prob = dist.cdf(-abs(t_computed))\n",
        "p_case1 = 2 * tail_prob\n",
        "reject_case1 = p_case1 <= alpha"
      ],
      "metadata": {
        "id": "FArBXzdEj90p"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Case 2: left-sided test\n",
        "p_case2 = dist.cdf(t_computed)        # P(T <= t_computed)\n",
        "reject_case2 = p_case2 <= alpha"
      ],
      "metadata": {
        "id": "IEYMeBx1kArY"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Case 3: right-sided test\n",
        "p_case3 = 1 - dist.cdf(t_computed)    # P(T >= t_computed)\n",
        "reject_case3 = p_case3 <= alpha"
      ],
      "metadata": {
        "id": "4CvAGQoPkBlf"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Section 3.1.3. Confidence Intervals\n"
      ],
      "metadata": {
        "id": "NDdUhyeFc7gX"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "theta_hat = 1.5614   # example point estimate",
        "sigma_hat = 0.2932   # example standard error",
        "# lower and upper critical values (general, not assuming symmetry)\n",
        "t_lower = dist.ppf(alpha / 2.0)        # corresponds to inv(0.5*alpha) in MATLAB\n",
        "t_upper = dist.ppf(1 - alpha / 2.0)    # corresponds to inv(1-0.5*alpha) in MATLAB\n",
